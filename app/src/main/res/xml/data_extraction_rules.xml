<!--
  ~ Backup and device-to-device transfer rules for Android 12 and above. Keep in sync with
  ~ backup_rules.xml.
  -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="me.zhanghai.android.files_preferences_no_backup.xml" />
        <exclude
            domain="sharedpref"
            path="trusted_intent_token.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="me.zhanghai.android.files_preferences_no_backup.xml" />
        <exclude
            domain="sharedpref"
            path="trusted_intent_token.xml" />
    </device-transfer>
</data-extraction-rules>
